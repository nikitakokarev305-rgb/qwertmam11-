-- Поиск блока победы (TouchInterest или имя)
local function getWinPart()
    -- 1. Ищем TouchInterest (триггер касания) в Workspace
    for _, item in ipairs(workspace:GetDescendants()) do
        if item:IsA("TouchTransmitter") then
            local parent = item.Parent
            if parent and parent:IsA("BasePart") then
                local pName = parent.Name:lower()
                if pName:find("win") or pName:find("finish") or pName:find("end") or pName:find("reward") then
                    return parent
                end
            end
        end
    end
    
    -- 2. Если не нашли по имени, берем любой объект с именем Win/Finish
    for _, item in ipairs(workspace:GetDescendants()) do
        if item:IsA("BasePart") then
            local pName = item.Name:lower()
            if pName:find("win") or pName:find("finish") or pName:find("end") then
                return item
            end
        end
    end
    return nil
end

-- Цикл фарма
task.spawn(function()
    while true do
        task.wait(0.3)
        if autoFarmActive then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            
            if root then
                local target = getWinPart()
                if target then
                    -- Телепорт
                    root.CFrame = target.CFrame + Vector3.new(0, 2, 0)
                    
                    -- Симуляция касания (для надежности)
                    firetouchinterest(root, target, 0)
                    task.wait(0.1)
                    firetouchinterest(root, target, 1)
                end
            end
        end
    end
end)

